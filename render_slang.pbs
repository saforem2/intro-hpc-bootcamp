#!/bin/bash -l
# NB: `-l` is MANDATORY. Without it PBS uses a non-interactive shell where
# `module load conda` provides no conda binary, quarto silently falls back to
# /usr/bin/python3, and the job can "succeed" having rendered nothing.
#PBS -N slang-ft
#PBS -l select=1:system=polaris
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
#PBS -q debug
#PBS -A datascience
#PBS -j oe
#PBS -o /home/foremans/slang-ft.log

set -euo pipefail
cd "${PBS_O_WORKDIR:-$HOME/projects/saforem2/intro-hpc-bootcamp-2025}"

module use /soft/modulefiles
module load conda
conda activate base

# Compute nodes reach the internet only through the ALCF proxy. The page pulls
# the slang CSV and the SmolLM2 weights from HuggingFace.
export HTTP_PROXY=http://proxy.alcf.anl.gov:3128
export HTTPS_PROXY=http://proxy.alcf.anl.gov:3128
export http_proxy=$HTTP_PROXY
export https_proxy=$HTTPS_PROXY
export USE_TF=0                     # transformers Keras-3 probe hard-fails otherwise
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1
export MPLCONFIGDIR="$(mktemp -d)"

PAGE=05-capstone/2-slang-finetune
QUARTO=$HOME/opt/quarto-1.10.16/bin/quarto

# --- fail fast: a broken env must not masquerade as a successful render ---
python3 -c "import jupyter_client, jupyter_cache" || { echo "FATAL: jupyter deps"; exit 3; }
python3 -c "import torch; assert torch.cuda.is_available(), 'no cuda'" || { echo "FATAL: no GPU"; exit 4; }
python3 -c "import transformers, pandas, plotly, numpy" || { echo "FATAL: page deps"; exit 5; }
python3 -c "import ezpz; print('ezpz device:', ezpz.get_torch_device_type())" || { echo "FATAL: ezpz"; exit 6; }
python3 -c "import torch; print('GPU:', torch.cuda.get_device_name(0))"

# --- freeze:auto would replay the committed Mac/CPU results instead of running on GPU ---
rm -rf "content/_freeze/${PAGE}" "content/${PAGE}/.jupyter_cache" "docs/${PAGE}/index_files"

cd content
"$QUARTO" render "${PAGE}/index.qmd" --to html
cd ..

echo "=== provenance check ==="
grep -o 'steps in [0-9]* s\{0,1\} on cuda\|on cuda' "docs/${PAGE}/index.html" | head -3
grep -c 'cell-output-error' "docs/${PAGE}/index.html" || true
echo "=== done ==="
